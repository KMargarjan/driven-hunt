# Roblox / Rojo project ignores.
# Previous Node.js template archived at backups/2026-09-24_gitignore-node-template.txt

# Wally packages (restore with `wally install`)
/Packages/
/DevPackages/
/ServerPackages/

# Place/model build outputs and Studio lock files (the place itself lives on Roblox)
*.rbxl
*.rbxlx
*.rbxl.lock
*.rbxlx.lock
/build/

# Generated by `rojo sourcemap` for Luau LSP
sourcemap.json

# Editors / OS
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
.DS_Store
Thumbs.db
desktop.ini

# Python caches from tools/
__pycache__/

# Harness sync token (written by tools/studio_mcp.py, synced to ReplicatedStorage.TestSyncToken)
/tests/sync-token.txt


# Secrets: never commit (public repo, see CLAUDE.md "Public repository")
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.crt
id_rsa*
id_ed25519*
*.keystore
secrets/
.secrets/
*.secret
*.secrets
credentials*.json
service-account*.json
*.cookie
.ROBLOSECURITY*
.npmrc
.pypirc

# Raw agent session output (tools/agents.py)
/.agent-logs/

# Precomputed review evidence (tools/agents.py). NOT repo content, and it reliably contains local
# absolute paths -- rojo-build.txt records the `rojo build --output` line verbatim -- so one blind
# `git add -A` would re-commit exactly what Task 49 scrubbed out (Task 49 review note b).
/.agent-evidence/

# Asset pipeline run records (docs/design/asset-pipeline.md 7.2): file names and ids, not repo content.
/.assets/

# Screenshots saved by `python tools/studio_mcp.py capture` (rule-5 evidence, not repo content)
/.screenshots/

# Map generator run logs (tools/mapgen.py, one JSON per run; evidence, not repo content)
/.mapgen/
